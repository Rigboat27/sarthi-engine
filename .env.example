# Sarthi Core engine — copy to .env and fill in.
# Defaults are mock-first: nothing hits the network or spends money.

MOCK_MODE=true

# Sarvam (speech). https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Gemini (conversation LLM). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Frugality guard: refuse spend past this many INR (crude estimate).
SPEND_CAP_INR=100
